        {
          "name": "01 - Create Merchant",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/merchants",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Demo Merchant\",\n  \"businessName\": \"Demo Office Supplies\",\n  \"email\": \"demo{{$timestamp}}@example.com\",\n  \"phone\": \"+919876543210\",\n  \"description\": \"Demo merchant for API testing\",\n  \"currency\": \"INR\",\n  \"agentEnabled\": true,\n  \"agentDescription\": \"AI commerce agent for office supplies\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201',()=>pm.response.to.have.status(201));",
                  "const j=pm.response.json();",
                  "const id=j.data?._id||j.data?.id;",
                  "if(id) pm.collectionVariables.set('merchantId',id);",
                  "pm.test('Merchant ID returned',()=>pm.expect(id).to.exist);"
